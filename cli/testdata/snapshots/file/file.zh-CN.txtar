-- zh-CN/01-file-typo-json/argv --
crater file list --json --no-interactive
-- zh-CN/01-file-typo-json/exit --
2
-- zh-CN/01-file-typo-json/stdout --
-- zh-CN/01-file-typo-json/stderr --
{
  "category": "usage_error",
  "code": "ERR_UNKNOWN_COMMAND",
  "message": "unknown command \"list\" for \"crater file\"\n\nDid you mean this?\n\tls\n\nRun \"crater file --help\" for usage."
}
